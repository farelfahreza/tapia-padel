# ---------------------------------------------------------------------------
# Padel Racket Deal Finder - example environment.
# Copy to .env for local runs. NEVER commit a filled-in .env.
# On Railway these are set as service variables (the cron job is stateless:
# nothing below is ever written to local disk).
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Railway provides this automatically when a Postgres plugin is attached.
DATABASE_URL=postgresql://user:password@localhost:5432/padel

# --- Vinted collection (unofficial internal JSON endpoint) -----------------
# Session cookie copied from an authenticated browser session. Required for
# real collection; supplied by env only, never persisted.
# Format: the raw Cookie header value, e.g. "_vinted_fr_session=abc123; anon_id=..."
VINTED_SESSION_COOKIE=

# Honest self-identification. Put a real contact address here.
HTTP_USER_AGENT=tapia-padel-deal-finder/0.1 (+mailto:you@example.com)

VINTED_BASE_URL=https://www.vinted.fr
VINTED_CATALOG_ID=4597
# Requests per minute ceiling for the source (be gentle).
VINTED_REQUESTS_PER_MINUTE=10
VINTED_PER_PAGE=96
# Pages to page through in browse mode (the day-to-day price-database builder).
VINTED_BROWSE_MAX_PAGES=3
# Pages per watchlist entry in targeted mode.
VINTED_SEARCH_MAX_PAGES=1
VINTED_TIMEOUT_SECONDS=20
# Seconds to wait when the source asks us to back off and sends no Retry-After.
VINTED_BACKOFF_SECONDS=60

# Vinted status_id values used for the query-level condition filter.
# BEST-EFFORT mapping (6=New with tags, 1=New without tags, 2=Very good).
# Override here if Vinted's ids change; the post-fetch filter below always
# runs as well, so a wrong id can never let an excluded condition through.
VINTED_STATUS_IDS=6,1,2

# --- Condition allow-list (single source of truth) -------------------------
# Only these Vinted condition levels are ever considered. Loosen here, not in code.
ACCEPTED_CONDITIONS=New with tags,New without tags,Very good

# --- Fees & costs (EUR). Buy side and sell side modelled separately. -------
# Buy side: on Vinted the BUYER pays the protection fee and the shipping, so
# these are what I pay to acquire a racket.
BUYER_PROTECTION_PCT=0.05
# Any fixed part of the buyer protection fee. Zero today - the fee is a
# straight 5% - but kept configurable in case that changes.
BUYER_PROTECTION_FIXED_EUR=0.00
# Default shipping I pay, used when no location rule below matches.
BUY_SHIPPING_EUR=5.00
# Shipping depends on where the racket ships from. "fragment:amount" pairs,
# matched against the listing location, first match wins. Leave empty to use
# the default above for everything.
BUY_SHIPPING_BY_LOCATION=corse:9.00,belgique:8.00,suisse:12.00
# My own packaging cost on resale. Not a Vinted fee - set to 0 if you reuse
# the box the racket arrived in.
PACKAGING_COST_EUR=1.00
# Sell side: Vinted takes no seller fee, and my buyer pays the shipping, so
# nothing comes off the top of the resale. Kept as parameters anyway - a
# marketplace introducing a seller fee is exactly the change that would
# silently wreck every margin below.
SELLER_FEE_PCT=0.00
SELLER_FEE_FIXED_EUR=0.00
SELL_SHIPPING_COST_EUR=0.00

# --- Pricing / estimate honesty -------------------------------------------
# Observed prices are ASKING prices, not sale prices. Haircut applied before
# calling anything a resale estimate.
RESALE_REALIZATION_FACTOR=0.92
# Observations older than this are ignored.
OBSERVATION_WINDOW_DAYS=180
# Below this many observations there is no usable estimate at all.
MIN_OBSERVATIONS=3
# Observation count at which confidence is considered full.
TARGET_OBSERVATIONS=12
MEDIUM_CONFIDENCE_OBSERVATIONS=5
HIGH_CONFIDENCE_OBSERVATIONS=10

# --- Scoring ---------------------------------------------------------------
WEIGHT_PRICE_ADVANTAGE=35
WEIGHT_ROI=25
WEIGHT_CONDITION=15
WEIGHT_DEMAND=10
WEIGHT_LIQUIDITY=10
WEIGHT_LOCATION=5
# A listing hits full marks on price advantage at this discount vs typical price.
TARGET_DISCOUNT=0.35
TARGET_ROI=0.40
TARGET_PROFIT_EUR=40
DEMAND_TARGET_LISTINGS=8
LIQUIDITY_TARGET_SIGNALS=5
DEMAND_WINDOW_DAYS=90
# A listing seen more than once and then gone for this long counts as a
# turnover signal (sold or delisted - a proxy, not confirmed sales data).
TURNOVER_STALE_DAYS=14
# Comma-separated, matched loosely against the listing location.
PREFERRED_LOCATIONS=paris,ile-de-france,hauts-de-seine,seine-saint-denis
# Hard floors. Below either of these a listing is capped under both alert
# thresholds, no matter how good the rest of the score looks.
MIN_PROFIT_EUR=15
MIN_ROI=0.20
# Score ceiling when there is no usable resale estimate (cold start).
COLD_START_SCORE_CAP=15
UNPROFITABLE_SCORE_CAP=40

# --- Notification policy (two thresholds) ----------------------------------
# On my watchlist: a decent deal is worth a ping.
WATCHLIST_SCORE_THRESHOLD=60
# Not on my watchlist: only exceptional deals.
EXCEPTIONAL_SCORE_THRESHOLD=80
# Never alert on an estimate built from fewer observations than this.
MIN_OBSERVATIONS_TO_NOTIFY=5
# Re-alert an already-notified listing only if its price dropped by this much.
RENOTIFY_PRICE_DROP_PCT=0.10
MAX_NOTIFICATIONS_PER_RUN=10

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=15
# Process /watch /unwatch /list /help at the start of each run.
TELEGRAM_COMMANDS_ENABLED=true

# --- Run behaviour ---------------------------------------------------------
# true = collect and evaluate, but send nothing and persist nothing.
DRY_RUN=false
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
